---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const source = "https://github.com/Stiven-Gjekaj/markdown-to-wattpad";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <meta name="color-scheme" content="light dark" />
    <meta
      name="theme-color"
      content="#f6f1ea"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#14110e"
      media="(prefers-color-scheme: dark)"
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
  </head>

  <body>
    <a class="skip" href="#main">Skip to the converter</a>

    <header class="site-header">
      <a class="brand" href={`${base}/`}>
        <svg
          class="mark"
          viewBox="0 0 64 64"
          width="28"
          height="28"
          aria-hidden="true"
        >
          <rect width="64" height="64" rx="14" class="mark-back"></rect>
          <path
            class="mark-ink"
            d="M30 14H44V50H40V18H34V50H30V36A11 11 0 0 1 30 14Z"></path>
        </svg>
        <span>Markdown to Wattpad</span>
      </a>
      <nav class="site-nav" aria-label="Site">
        <a href="#how">How it works</a>
        <a href={source}>Source</a>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <p>
        Your chapter stays in this browser. The page converts it on your
        device, and there is no server that could receive it.
      </p>
      <p>
        Not made by Wattpad, and not connected to it. Wattpad is a trademark
        of its owner.
      </p>
      <p class="footer-links">
        <a href={source}>Source</a>
        <span aria-hidden="true">/</span>
        <a href={`${source}/blob/main/LICENSE`}>MIT licence</a>
        <span aria-hidden="true">/</span>
        <a href={`${source}/blob/main/TERMS.md`}>Terms</a>
      </p>
    </footer>
  </body>
</html>
