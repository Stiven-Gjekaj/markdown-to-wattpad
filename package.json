{
  "name": "markdown-to-wattpad",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "node scripts/serve-dist.mjs",
    "check": "astro check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "verify": "pnpm lint && pnpm check && pnpm test && pnpm build"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.3",
    "marked": "^18.0.13"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@biomejs/biome": "^2.5.14",
    "@playwright/test": "^1.63.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
